# Copy to .env and fill in. Never commit .env.

ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
WEB_PORT=80

# Public URL the browser uses to call the API (baked into the Angular build)
API_BASE_URL=http://localhost:8080/api/

# External DB (RDS etc.). For the local-db profile use Server=sqlserver,1433;User=sa;Password=<SQL_SA_PASSWORD>
DB_CONNECTION=Server=your-db-host,1433;Database=Karbar_DB;User=youruser;Password=yourpassword;TrustServerCertificate=True;MultipleActiveResultSets=true;
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars

SAP_BASE_URL=http://s4dev.bergerbd.com:8001/sap/opu/odata/sap/
SAP_USERNAME=
SAP_PASSWORD=

# Only for --profile local-db (min 8 chars, upper/lower/digit/symbol)
SQL_SA_PASSWORD=Your_Strong_Passw0rd!
SQL_PORT=1433
