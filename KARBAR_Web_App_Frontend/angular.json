{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "berger-karbar": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/berger-karbar",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/assets",
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.scss",
              "src/assets/scss/style.scss",
              "src/assets/scss/lib/boxicons.min.scss",
              "src/assets/scss/lib/font-awesome.min.scss",
              "src/assets/scss/lib/material-icons.scss"
            ],
            "scripts": [
              "src/assets/js/lib/moment.min.js",
              "src/assets/js/lib/jquery.min.js",
              "src/assets/js/script.js"
            ]
          },
            "configurations": {
              "production": {
                  "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.prod.ts"
                  }
                ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "25MB",
                  "maximumError": "25MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "25MB",
                  "maximumError": "25MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          
          "configurations": {
            "production": {
              "buildTarget": "berger-karbar:build:production"
            },
            "development": {
              "buildTarget": "berger-karbar:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "d17f98b1-03bb-4813-9392-d25054272081"
  }
}
